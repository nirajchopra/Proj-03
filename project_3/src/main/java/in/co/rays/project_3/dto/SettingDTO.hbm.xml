<?xml version="1.0"?>
  <!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

  <hibernate-mapping package="in.co.rays.project_3.dto">
  	<class name="SettingDTO" table="ST_SETTING">

  		<id name="id" type="java.lang.Long">
  			<column name="ID"></column>
  			<generator class="increment"></generator>
  		</id>

  		<property name="settingId" type="java.lang.String">
  			<column name="SETTING_ID" />
  		</property>

  		<property name="settingName" type="java.lang.String">
  			<column name="SETTING_NAME" />
  		</property>

  		<property name="settingKey" type="java.lang.String">
  			<column name="SETTING_KEY" />
  		</property>

  		<property name="settingValue" type="java.lang.String">
  			<column name="SETTING_VALUE" />
  		</property>

  		<property name="settingType" type="java.lang.String">
  			<column name="SETTING_TYPE" />
  		</property>

  		<property name="description" type="java.lang.String">
  			<column name="DESCRIPTION" />
  		</property>

  		<property name="status" type="java.lang.String">
  			<column name="STATUS" />
  		</property>

  		<property name="createdBy" type="java.lang.String" length="50">
  			<column name="CREATED_BY" />
  		</property>

  		<property name="modifiedBy" type="java.lang.String" length="50">
  			<column name="MODIFIED_BY" />
  		</property>

  		<property name="createdDatetime" type="java.sql.Timestamp">
  			<column name="CREATED_DATETIME" />
  		</property>

  		<property name="modifiedDatetime" type="java.sql.Timestamp">
  			<column name="MODIFIED_DATETIME" />
  		</property>

  	</class>
  </hibernate-mapping>
